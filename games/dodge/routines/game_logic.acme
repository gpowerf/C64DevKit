;; game_logic.acme — Sprite Dodge: full game logic
;; HUD text/numbers handled by behavior DSL (see behaviors.yaml).
;; This file: keyboard, enemy AI, collision, state machine, sound.

    jmp gstart

;; --- Variables ---
score:      !byte 0, 0
lives:      !byte 3
enemy_x:    !byte 100
enemy_y:    !byte 80
enemy_init: !byte 0
hit_timer:  !byte 0
snd_timer:  !byte 0
state:      !byte 0
state_tmr:  !byte 0
score_tmr:  !byte 0
flash_tmr:  !byte 0
init_done:  !byte 0
go_drawn:   !byte 0
speed_ctr:  !byte 0
last_safe:  !byte 0

GAME_PLAYING = 0
GAME_DYING   = 1
GAME_OVER    = 2
SCRN = $0400

gstart:
    jsr init_once
    jsr keyboard_read
    lda state
    cmp #GAME_PLAYING
    bne g1
    jmp do_play
g1:
    cmp #GAME_DYING
    bne g2
    jmp do_die
g2:
    cmp #GAME_OVER
    bne gdone
    jmp do_over
gdone:
    rts

;; ============================================================
init_once:
    lda init_done
    beq do_init
    rts

do_init:
    inc init_done

    ;; Border + zones + screen fill
    lda #11
    sta $d020

    ;; Fill screen with solid blocks (shows color RAM zones)
    ldx #0
    lda #$a0
clr_scr:
    sta SCRN, x
    sta SCRN+$100, x
    sta SCRN+$200, x
    sta SCRN+$2e8, x
    inx
    bne clr_scr

    ;; 3 zone colors in color RAM
    lda #<$d800
    sta $02
    lda #>$d800
    sta $03
    ldx #25
z_row:
    ldy #0
    lda #5                  ; green — score zone
z_grn:
    sta ($02), y
    iny
    cpy #13
    bne z_grn
    lda #0                  ; black — neutral
z_blk:
    sta ($02), y
    iny
    cpy #28
    bne z_blk
    lda #6                  ; blue — safe
z_blu:
    sta ($02), y
    iny
    cpy #40
    bne z_blu
    lda $02
    clc
    adc #40
    sta $02
    bcc z_nh
    inc $03
z_nh:
    dex
    bne z_row

    ;; Top line header in white (overrides zone colors on row 0)
    ldx #0
    lda #1
clr_col:
    sta $d800, x
    inx
    cpx #40
    bne clr_col

    ;; Init enemy position on VIC-II registers
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    rts

;; ============================================================
;; PLAYING state
;; ============================================================
do_play:
    jsr enemy_do
    jsr score_do
    jsr collision_do
    rts

;; ============================================================
;; DYING state
;; ============================================================
do_die:
    lda flash_tmr
    beq die_toggle
    dec flash_tmr
    jmp die_count

die_toggle:
    lda $d015
    eor #$01
    sta $d015
    lda #4
    sta flash_tmr

die_count:
    dec state_tmr
    bne dd_rts
    lda lives
    beq die_gameover
    ;; Respawn
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    lda #$03
    sta $d015
    lda #150
    sta hit_timer
    lda #GAME_PLAYING
    sta state
    lda #0
    sta go_drawn
dd_rts:
    rts

die_gameover:
    lda #$01
    sta $d015
    lda #GAME_OVER
    sta state
    lda #0
    sta go_drawn
    rts

;; ============================================================
;; GAME OVER state
;; ============================================================
do_over:
    lda go_drawn
    bne ov_wait
    inc go_drawn
    jsr draw_gameover
    lda #<5000
    sta $D400
    lda #>5000
    sta $D401
    lda #$21
    sta $D404
    lda #$01
    sta $D405
    lda #$00
    sta $D406
    lda #$0F
    sta $D418
    lda #30
    sta snd_timer
    jsr sound_tick
    rts

ov_wait:
    jsr sound_tick
    lda #$7f
    sta $dc00
    lda $dc01
    and #$10
    bne ov_done
    jsr restart
ov_done:
    rts

draw_gameover:
    ;; Set color rows 12-13 to white
    ldx #0
    lda #1
go_col:
    sta $d9e0, x
    sta $da08, x
    inx
    cpx #40
    bne go_col

    ;; Clear text area
    ldx #0
    lda #$20
go_clr:
    sta SCRN+$1E0, x
    sta SCRN+$208, x
    inx
    cpx #40
    bne go_clr

    ldx #0
go_txt:
    lda over_text, x
    beq go_done
    sta SCRN+$1E0+16, x
    inx
    bne go_txt
go_done:
    ldx #0
sp_txt:
    lda space_text, x
    beq sp_done
    sta SCRN+$208+13, x
    inx
    bne sp_txt
sp_done:
    rts

over_text:  !scr "game over", 0
space_text: !scr "press space to play", 0

;; ============================================================
restart:
    lda #3
    sta lives
    lda #0
    sta score
    sta score+1
    sta state
    sta state_tmr
    sta snd_timer
    sta speed_ctr
    sta go_drawn
    sta last_safe
    lda #10
    sta hit_timer

    lda #160
    sta $d000
    lda #120
    sta $d001
    lda $d010
    and #$FE
    sta $d010

    lda #100
    sta enemy_x
    sta $d002
    lda #80
    sta enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    lda #$03
    sta $d015

    ;; Restore zone colors on game-over rows
    ldy #0
r_green:
    lda #5
    sta $d9e0, y
    sta $da08, y
    iny
    cpy #13
    bne r_green
r_black:
    lda #0
    sta $d9e0, y
    sta $da08, y
    iny
    cpy #28
    bne r_black
r_blue:
    lda #6
    sta $d9e0, y
    sta $da08, y
    iny
    cpy #40
    bne r_blue

    ;; Clear game over text from screen (solid blocks for zone visibility)
    ldx #0
    lda #$a0
rest_clr:
    sta SCRN+$1E0, x
    sta SCRN+$208, x
    inx
    cpx #40
    bne rest_clr
    rts

;; ============================================================
;; Keyboard — WASD, 9-bit X positioning with bounds
;; ============================================================
keyboard_read:
    lda #0
    sta joystick_state

    lda #$fd
    sta $dc00
    lda $dc01
    and #$02
    bne k1
    lda $d001
    cmp #50
    bcc k1
    beq k1
    dec $d001
k1:
    lda #$fd
    sta $dc00
    lda $dc01
    and #$20
    bne k2
    lda $d001
    cmp #229
    bcs k2
    inc $d001
k2:
    lda #$fd
    sta $dc00
    lda $dc01
    and #$04
    bne k3
    lda $d000
    cmp #24
    bne .do_left
    lda $d010
    and #$01
    beq k3
.do_left:
    lda $d000
    bne .dec_left
    lda $d010
    and #$01
    beq k3
    dec $d010
    dec $d000
    jmp k3
.dec_left:
    dec $d000
k3:
    lda #$fb
    sta $dc00
    lda $dc01
    and #$04
    bne kdone
    lda $d000
    cmp #64
    bcc .do_right
    lda $d010
    and #$01
    bne kdone
.do_right:
    lda $d000
    cmp #255
    bne .inc_right
    inc $d000
    lda $d010
    ora #$01
    sta $d010
    jmp kdone
.inc_right:
    inc $d000
kdone:
    rts

;; ============================================================
;; Enemy AI
;; ============================================================
enemy_do:
    lda enemy_init
    bne e_active
    inc enemy_init
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    rts

e_active:
    inc speed_ctr
    lda speed_ctr
    cmp #2
    bcc e_done
    lda #0
    sta speed_ctr

    lda $d000
    cmp enemy_x
    beq e_chy
    bcc e_ml
    inc enemy_x
    jmp e_chy
e_ml:
    dec enemy_x

e_chy:
    lda $d001
    cmp enemy_y
    beq e_clamp
    bcc e_mu
    inc enemy_y
    jmp e_clamp
e_mu:
    dec enemy_y

e_clamp:
    lda enemy_x
    cmp #24
    bcs e_xhi
    lda #24
    sta enemy_x
    bne e_cy
e_xhi:
    cmp #255
    bcc e_cy
    lda #255
    sta enemy_x

e_cy:
    lda enemy_y
    cmp #50
    bcs e_yhi
    lda #50
    sta enemy_y
    bne e_wr
e_yhi:
    cmp #229
    bcc e_wr
    lda #229
    sta enemy_y

e_wr:
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
e_done:
    rts

;; ============================================================
;; Score tick
;; ============================================================
score_do:
    lda $d010
    and #$01
    beq .not_safe

    lda last_safe
    bne s_done
    lda #1
    sta last_safe
    sec
    lda score
    sbc #5
    sta score
    lda score+1
    sbc #0
    bcs s_done
    lda #0
    sta score
    sta score+1
    rts

.not_safe:
    lda #0
    sta last_safe

    inc score_tmr
    lda score_tmr
    cmp #20
    bcc s_done
    lda #0
    sta score_tmr

    lda $d000
    cmp #128
    bcs s_done
    clc
    lda score
    adc #2
    sta score
    lda score+1
    adc #0
    sta score+1

s_done:
    rts

;; ============================================================
;; Collision
;; ============================================================
collision_do:
    lda hit_timer
    beq c_check
    dec hit_timer
    rts

c_check:
    lda $d01e
    and #$03
    beq c_no

    sta $d01e

    dec lives

    lda $d000
    cmp #128
    bcc .spawn_right
    lda #50
    jmp .spawn_x
.spawn_right:
    lda #200
.spawn_x:
    sta enemy_x
    sta $d002
    lda $d010
    and #$FD
    sta $d010
    lda $d001
    cmp #140
    bcc .spawn_bottom
    lda #60
    jmp .spawn_y
.spawn_bottom:
    lda #210
.spawn_y:
    sta enemy_y
    sta $d003

    lda #<5000
    sta $D400
    lda #>5000
    sta $D401
    lda #$21
    sta $D404
    lda #$01
    sta $D405
    lda #$00
    sta $D406
    lda #$0F
    sta $D418
    lda #20
    sta snd_timer

    lda #GAME_DYING
    sta state
    lda #150
    sta state_tmr
    lda #0
    sta flash_tmr
    rts

c_no:
    rts

;; ============================================================
;; Sound tick
;; ============================================================
sound_tick:
    lda snd_timer
    beq st_done
    dec snd_timer
    bne st_done
    lda $D404
    and #$FE
    sta $D404
st_done:
    rts
