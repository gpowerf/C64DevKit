;; game_logic.acme — Sprite Dodge: full game logic
;; HUD text/numbers handled by behavior DSL (see behaviors.yaml).
;; This file: keyboard, enemy AI, collision, state machine, sound.

CHEAT_KEYS = 1        ; 1=enabled (debug), 0=disabled (release)

    jmp gstart

;; --- Variables ---
score:      !byte 0, 0
lives:      !byte 3
enemy_x:    !byte 100
enemy_y:    !byte 80
enemy_init: !byte 0
hit_timer:  !byte 0
snd_timer:  !byte 0
state:      !byte 3    ; 0=playing 1=dying 2=gameover 3=splash
state_tmr:  !byte 0
score_tmr:  !byte 0
zone_ticks: !byte 0          ; consecutive score-zone ticks
flash_tmr:  !byte 0
init_done:  !byte 0
splash_done: !byte 0
go_drawn:   !byte 0
speed_ctr:  !byte 0
last_safe:  !byte 0
player_dir: !byte 0    ; 0=right 1=left 2=up 3=down
player_moving: !byte 0 ; set by keyboard_read when position changed this frame
prev_x: !byte 0        ; sprite 0 X last frame (movement detection)
prev_y: !byte 0        ; sprite 0 Y last frame (movement detection)
dmz_seed:   !byte $5A  ; LFSR seed for DMZ noise
dmz_color:  !byte 6    ; cycling color index (0-7)
dmz_timer:  !byte 1    ; countdown to next DMZ refresh
dmz_col:    !byte 0
dmz_row:    !byte 1

level:      !byte 1    ; difficulty level (1-5+)
prev_k:     !byte 0    ; previous score/1000 threshold
speed_frac: !byte 128  ; fractional speed (128/256*50 = 25 px/s)
ast_timer:  !byte 40   ; countdown to next asteroid spawn
ast_active: !byte 0    ; bits 0-2: which asteroids are active
ast_msb:    !byte 0    ; $D010 MSB bits for X >= 256
ast_x:      !byte 24, 24, 24
ast_y:      !byte 250, 250, 250
ast_dx:     !byte 0, 0, 0
ast_dy:     !byte 0, 0, 0
ast_count:  !byte 0
ast_vx:     !byte 0    ; temp during spawn
ast_vy:     !byte 0
ast_warn_dir: !byte 255 ; 0=bottom, 1=top, 2=right, 3=left, 255=none
ast_next_vx:  !byte 0
ast_next_vy:  !byte 0
ast_warn_x:   !byte 0    ; pre-rolled pixel spawn X
ast_warn_y:   !byte 0    ; pre-rolled pixel spawn Y
c_saved:    !byte 0    ; saved $D01E for multi-check
cheat_spc:  !byte $FF  ; previous SPACE state (edged)
radar_was:  !byte 0     ; radar visibility edge detect
pulse_ctr:  !byte 0     ; enemy colour pulse timer
trans_ready: !byte 0    ; flag: trigger transition on next frame
trans_tmr:  !byte 0     ; transition countdown
trans_level: !byte 0    ; level to display
trans_done: !byte 0     ; text drawn flag
ship_ctr:  !byte 0     ; ship animation counter (every 8 frames)
ship_frame: !byte 0    ; ship animation frame (0-1)
enemy_ctr: !byte 0     ; enemy animation counter (every 6 frames)
enemy_frame: !byte 0   ; enemy animation frame (0-3)
boom_tmr:  !byte 0     ; death-boom countdown (0 = inactive, 60 = just died)
pwr_avail: !byte 0     ; invincibility charge available (0/1)
pwr_flash: !byte 0     ; flash cycle counter during invincibility
pwr_key:   !byte 0     ; fire/shift edge state (0=held, 1=released)
pad:        !byte 0    ; guard byte — prevents writes from hitting gstart

GAME_PLAYING    = 0
GAME_DYING      = 1
GAME_OVER       = 2
GAME_SPLASH     = 3
GAME_TRANSITION = 4
SCRN = $0400

gstart:
    jsr sfx_gate_off       ; tick preset sound timers
    jsr sfx_tick_all       ; tick multi-frame presets
    jsr boom_tick          ; tick the death boom (voice 2+3 sweep)
    jsr init_once
    jsr dmz_do
    lda state
    cmp #GAME_SPLASH
    bne g0
    jmp do_splash
g0:
    cmp #GAME_TRANSITION
    bne g0a
    jmp do_transition
g0a:
    jsr keyboard_read
    jsr cheat_keys
    jsr anim_update
    jsr engine_do
    ;; Set sprite 0 pointer = $80 + player_dir + ship_frame * 5
    lda player_dir
    clc
    adc #$80
    ldx ship_frame
    beq .sp_set
    clc
    adc #5
.sp_set:
    sta $07F8
    ;; Set sprite 1 pointer = $84 + enemy_frame (skip 4 blocks if frame>0,
    ;; jumping over the ship frame-1 blocks; frames 0-6 → $84, $89-$8E)
    lda enemy_frame
    beq .en_base
    clc
    adc #4
.en_base:
    clc
    adc #$84
    sta $07F9
    ;; Powerup charge HUD indicator (row 0, col 28)
    lda pwr_avail
    beq .p_hide
    lda #$10             ; PETSCII "P"
    sta $0400+28
    lda #1               ; white
    sta $d800+28
    jmp .p_ok
.p_hide:
    lda #$20             ; space
    sta $0400+28
    lda #0               ; black
    sta $d800+28
.p_ok:
    jsr level_update
    lda trans_ready
    beq .no_trans
    lda #0
    sta trans_ready
    lda #GAME_TRANSITION
    sta state
    lda #0
    sta $d015             ; hide sprites during transition
    lda level
    sta trans_level
    lda #90
    sta trans_tmr
    lda #0
    sta trans_done        ; 0 = needs to draw text
    rts                   ; skip rest of frame
.no_trans:
    jsr ast_update
    jsr radar_do
    lda state
    cmp #GAME_PLAYING
    bne g1
    jmp do_play
g1:
    cmp #GAME_DYING
    bne g2
    jmp do_die
g2:
    cmp #GAME_OVER
    bne gdone
    jmp do_over
gdone:
    rts

;; ============================================================
;; Sprite animation — cycles ship (2 frames) and enemy (7 frames)
;; ============================================================
anim_update:
    ;; Ship: trail shows only while flying.  Stationary (or outside
    ;; PLAYING) → freeze on frame 0, the no-trail pose.
    lda state
    cmp #GAME_PLAYING
    bne .ship_idle
    lda player_moving
    beq .ship_idle
    ;; Ship: moving → alternate every 2 frames (25 Hz flicker — the two
    ;; trail positions blend on the phosphor, reading as translucent
    ;; exhaust)
    inc ship_ctr
    lda ship_ctr
    cmp #2
    bcc .an_enemy
    lda #0
    sta ship_ctr
    lda ship_frame
    eor #1
    sta ship_frame
    jmp .an_enemy
.ship_idle:
    lda #0
    sta ship_ctr
    sta ship_frame
.an_enemy:
    ;; Enemy: cycle 0-6 every 6 frames (42-frame loop; frame 6 is the
    ;; widest, wrapping back to the rest pose of frame 0)
    inc enemy_ctr
    lda enemy_ctr
    cmp #6
    bcc .an_done
    lda #0
    sta enemy_ctr
    inc enemy_frame
    lda enemy_frame
    cmp #7
    bcc .an_done
    lda #0
    sta enemy_frame
.an_done:
    rts

;; ============================================================
init_once:
    lda init_done
    beq do_init
    rts

do_init:
    inc init_done

    ;; Movement-detection baseline: set from the current sprite 0
    ;; position so the first PLAYING frame doesn't register a fake move.
    lda $d000
    sta prev_x
    lda $d001
    sta prev_y

    ;; Seed LFSR from raster line for varied runs
    lda $d012
    eor #$5A
    sta dmz_seed

    ;; Border + zones + screen fill
    lda #11
    sta $d020
    lda #$0F
    sta $D418              ; master volume 15

    ;; Fill screen with solid blocks (shows color RAM zones)
    ldx #0
    lda #$a0
clr_scr:
    sta SCRN, x
    sta SCRN+$100, x
    sta SCRN+$200, x
    sta SCRN+$2e8, x
    inx
    bne clr_scr

    ;; 3 zone colors in color RAM
    lda #<$d800
    sta $02
    lda #>$d800
    sta $03
    ldx #25
z_row:
    ldy #0
    lda #6                  ; blue — score zone
z_grn:
    sta ($02), y
    iny
    cpy #13
    bne z_grn
    lda #0                  ; black — neutral
z_blk:
    sta ($02), y
    iny
    cpy #28
    bne z_blk
    lda #6                  ; blue — safe
z_blu:
    sta ($02), y
    iny
    cpy #40
    bne z_blu
    lda $02
    clc
    adc #40
    sta $02
    bcc z_nh
    inc $03
z_nh:
    dex
    bne z_row

    ;; Top line header: black background, text gets white from DSL
    ldx #0
    lda #0
clr_col:
    sta $d800, x
    inx
    cpx #40
    bne clr_col

    ;; Init enemy position on VIC-II registers
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    jsr dmz_init
    ;; Init asteroid sprites (2-4) — all point to rock at $2400 (block $90)
    lda #$90
    sta $07FA
    sta $07FB
    sta $07FC
    lda #7              ; yellow
    sta $d029
    lda #8              ; orange
    sta $d02a
    lda #10             ; light red
    sta $d02b
    ;; Place asteroids off-screen
    lda #0
    sta $d004
    sta $d006
    sta $d008
    lda #250
    sta $d005
    sta $d007
    sta $d009
    ;; Init radar sprite 5 — pointer and color
    lda #$91
    sta $07FD
    lda #7              ; yellow
    sta $d02c
    lda #0
    sta $d00a
    lda #250
    sta $d00b
    rts

;; ============================================================
;; PLAYING state
;; ============================================================
do_play:
    lda #0
    sta c_saved          ; clear stale collision from previous frame
    jsr pwr_check
    jsr enemy_do
    jsr score_do
    jsr collision_do
    jsr ast_collision
    ;; --- Unified invincibility flash (powerup + post-hit) ---
    lda hit_timer
    beq .inv_off
    lda pwr_flash
    beq .f_toggle
    dec pwr_flash
    jmp .inv_done
.f_toggle:
    lda $d015
    eor #$01             ; toggle sprite 0 visibility
    sta $d015
    lda #4
    sta pwr_flash
    jmp .inv_done
.inv_off:
    lda $d015
    ora #$01             ; flash must never end on a hidden frame
    sta $d015
.inv_done:
    rts

;; ============================================================
;; Powerup — fire/shift-triggered invincibility charge
;; ============================================================
pwr_check:
    ;; Fire (joystick port 2, active low)
    lda #$00
    sta $dc02            ; port A all inputs
    lda $dc00
    and #$10             ; bit 4: fire
    bne .fire_up
    jmp .pressed
.fire_up:
    lda #$ff
    sta $dc02            ; restore port A outputs
    ;; LEFT SHIFT (keyboard column $FD, row 7 → bit $80)
    lda #$fd
    sta $dc00
    lda $dc01
    and #$80
    bne .not_pressed
.pressed:
    lda #$ff
    sta $dc02            ; idempotent restore
    lda pwr_key
    beq .p_held          ; already down — no edge
    lda #0
    sta pwr_key          ; mark held
    lda pwr_avail
    beq .p_held          ; edge but no charge
    lda #0
    sta pwr_avail        ; consume charge
    lda hit_timer
    cmp #100
    bcs .keep            ; keep longer existing invincibility
    lda #100             ; 2 seconds at 50 fps
    sta hit_timer
.keep:
    lda #0
    sta pwr_flash
    jsr sfx_powerup      ; ascending 4-note arpeggio
.p_held:
    rts
.not_pressed:
    lda #1
    sta pwr_key          ; mark released
    rts

;; ============================================================
;; DYING state
;; ============================================================
do_die:
    lda flash_tmr
    beq die_toggle
    dec flash_tmr
    jmp die_count

die_toggle:
    lda $d015
    eor #$01
    sta $d015
    lda #4
    sta flash_tmr

die_count:
    dec state_tmr
    bne dd_rts
    lda lives
    beq die_gameover
    ;; Respawn
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    lda #$03
    sta $d015
    lda #150
    sta hit_timer
    lda #GAME_PLAYING
    sta state
    lda #0
    sta go_drawn
dd_rts:
    rts

die_gameover:
    lda #$01
    sta $d015
    lda #GAME_OVER
    sta state
    lda #0
    sta go_drawn
    rts

;; ============================================================
;; GAME OVER state
;; ============================================================
do_over:
    lda go_drawn
    bne ov_wait
    inc go_drawn
    jsr draw_gameover
    jsr sfx_drone          ; Atari-style low rumble
    jsr sound_tick
    rts

ov_wait:
    jsr sound_tick
    ;; Check SPACE
    lda #$7f
    sta $dc00
    lda $dc01
    and #$10
    beq ov_restart
    ;; Check joystick port 2 fire
    lda #$00
    sta $dc02
    lda $dc00
    and #$10
    tax
    lda #$ff
    sta $dc02
    txa
    bne ov_done
ov_restart:
    jsr restart
ov_done:
    rts

draw_gameover:
    ;; Set color rows 12-13 to white
    ldx #0
    lda #1
go_col:
    sta $d9e0, x
    sta $da08, x
    inx
    cpx #40
    bne go_col

    ;; Clear text area
    ldx #0
    lda #$20
go_clr:
    sta SCRN+$1E0, x
    sta SCRN+$208, x
    inx
    cpx #40
    bne go_clr

    ldx #0
go_txt:
    lda over_text, x
    beq go_done
    sta SCRN+$1E0+16, x
    inx
    bne go_txt
go_done:
    rts

over_text:  !scr "game over", 0

;; ============================================================
restart:
    lda #2
    sta $D028             ; enemy colour back to red
    lda #0
    sta pulse_ctr
    lda #0
    sta trans_ready
    sta trans_done
    lda #3
    sta lives
    lda #0
    sta score
    sta score+1
    sta state
    sta state_tmr
    sta snd_timer
    sta speed_ctr
    sta go_drawn
    sta last_safe
    lda #0
    sta zone_ticks
    sta score_tmr
    sta ship_ctr
    sta ship_frame
    sta enemy_ctr
    sta enemy_frame
    lda #0
    sta pwr_avail
    sta pwr_flash
    sta pwr_key
    lda #10
    sta hit_timer

    lda #160
    sta $d000
    lda #120
    sta $d001
    lda $d010
    and #$FE
    sta $d010

    lda #100
    sta enemy_x
    sta $d002
    lda #80
    sta enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    lda #$03
    sta $d015

    ;; Reset level + asteroids
    lda #1
    sta level
    lda #0
    sta prev_k
    lda #128
    sta speed_frac
    lda #40
    sta ast_timer
    lda #0
    sta ast_active
    sta ast_msb
    lda #255
    sta ast_warn_dir
    lda #0
    sta ast_warn_x
    sta ast_warn_y
    lda #0
    sta radar_was
    lda #0
    sta $d004
    sta $d006
    sta $d008
    lda #250
    sta $d005
    sta $d007
    sta $d009

    ;; Restore zone colors on game-over rows
    ldy #0
r_green:
    lda #6
    sta $d9e0, y
    sta $da08, y
    iny
    cpy #13
    bne r_green
r_black:
    lda #0
    sta $d9e0, y
    sta $da08, y
    iny
    cpy #28
    bne r_black
r_blue:
    lda #6
    sta $d9e0, y
    sta $da08, y
    iny
    cpy #40
    bne r_blue

    ;; Clear game over text from screen (solid blocks for zone visibility)
    ldx #0
    lda #$a0
rest_clr:
    sta SCRN+$1E0, x
    sta SCRN+$208, x
    inx
    cpx #40
    bne rest_clr
    rts

;; ============================================================
;; Keyboard — WASD, 9-bit X positioning with bounds
;; ============================================================
keyboard_read:
    lda #0
    sta joystick_state

    lda #$fd
    sta $dc00
    lda $dc01
    and #$02
    bne k1
    lda $d001
    cmp #58
    bcc k1
    beq k1
    dec $d001
    lda #2
    sta player_dir
k1:
    lda #$fd
    sta $dc00
    lda $dc01
    and #$20
    bne k2
    lda $d001
    cmp #229
    bcs k2
    inc $d001
    lda #3
    sta player_dir
k2:
    lda #$fd
    sta $dc00
    lda $dc01
    and #$04
    bne k3
    lda $d000
    cmp #24
    bne .do_left
    lda $d010
    and #$01
    beq k3
.do_left:
    lda #1
    sta player_dir
    lda $d000
    bne .dec_left
    lda $d010
    and #$01
    beq k3
    dec $d010
    dec $d000
    jmp k3
.dec_left:
    dec $d000
k3:
    lda #$fb
    sta $dc00
    lda $dc01
    and #$04
    bne kdone
    lda $d000
    cmp #64
    bcc .do_right
    lda $d010
    and #$01
    bne kdone
.do_right:
    lda #0
    sta player_dir
    lda $d000
    cmp #255
    bne .inc_right
    inc $d000
    lda $d010
    ora #$01
    sta $d010
    jmp kdone
.inc_right:
    inc $d000
kdone:
    ;; --- Joystick port 2 (active low, invert to active high) ---
    lda #$00
    sta $dc02            ; set port A all inputs (joystick read mode)
    lda $dc00
    eor #$ff
    tax                  ; save state in X
    lda #$ff
    sta $dc02            ; restore port A all outputs (keyboard write mode)

    ;; UP (bit 0)
    txa
    and #$01
    beq .joy_noup
    lda $d001
    cmp #58
    bcc .joy_noup
    beq .joy_noup
    dec $d001
    lda #2
    sta player_dir
.joy_noup:

    ;; DOWN (bit 1)
    txa
    and #$02
    beq .joy_nodown
    lda $d001
    cmp #229
    bcs .joy_nodown
    inc $d001
    lda #3
    sta player_dir
.joy_nodown:

    ;; LEFT (bit 2)
    txa
    and #$04
    beq .joy_noleft
    lda $d000
    cmp #24
    bne .joy_doleft
    lda $d010
    and #$01
    beq .joy_noleft
.joy_doleft:
    lda #1
    sta player_dir
    lda $d000
    bne .joy_decleft
    lda $d010
    and #$01
    beq .joy_noleft
    dec $d010
    dec $d000
    jmp .joy_noleft
.joy_decleft:
    dec $d000
.joy_noleft:

    ;; RIGHT (bit 3)
    txa
    and #$08
    beq .joy_noright
    lda $d000
    cmp #64
    bcc .joy_doright
    lda $d010
    and #$01
    bne .joy_noright
.joy_doright:
    lda #0
    sta player_dir
    lda $d000
    cmp #255
    bne .joy_incright
    inc $d000
    lda $d010
    ora #$01
    sta $d010
    jmp .joy_noright
.joy_incright:
    inc $d000
.joy_noright:
    ;; --- Movement detection: position delta vs previous frame ---
    ;; Set by actual VIC position change (covers keyboard + joystick,
    ;; including boundary clamping — no move, no flag).
    lda #0
    sta player_moving
    lda $d000
    cmp prev_x
    bne .mv_yes
    lda $d001
    cmp prev_y
    bne .mv_yes
    jmp .mv_store
.mv_yes:
    lda #1
    sta player_moving
.mv_store:
    lda $d000
    sta prev_x
    lda $d001
    sta prev_y
    rts

;; ============================================================
;; Enemy AI
;; ============================================================
enemy_do:
    ;; pulsate enemy colour at level 5+ (every 8 frames)
    lda level
    cmp #5
    bcc .no_pulse
    inc pulse_ctr
    lda pulse_ctr
    and #$08
    beq .red
    lda #10             ; light red
    bne .p_set
.red:
    lda #2              ; red
.p_set:
    sta $D028
.no_pulse:

    lda enemy_init
    bne e_active
    inc enemy_init
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    rts

e_active:
    clc
    lda speed_ctr
    adc speed_frac
    sta speed_ctr
    bcc e_done

    lda $d000
    cmp enemy_x
    beq e_chy
    bcc e_ml
    inc enemy_x
    jmp e_chy
e_ml:
    dec enemy_x

e_chy:
    lda $d001
    cmp enemy_y
    beq e_clamp
    bcc e_mu
    inc enemy_y
    jmp e_clamp
e_mu:
    dec enemy_y

e_clamp:
    lda enemy_x
    cmp #24
    bcs e_xhi
    lda #24
    sta enemy_x
    bne e_cy
e_xhi:
    cmp #224
    bcc e_cy
    lda #224
    sta enemy_x

e_cy:
    lda enemy_y
    cmp #58
    bcs e_yhi
    lda #110
    sta enemy_y
    bne e_wr
e_yhi:
    cmp #229
    bcc e_wr
    lda #229
    sta enemy_y

e_wr:
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
e_done:
    rts

;; ============================================================
;; Score tick
;; ============================================================
score_do:
    lda $d010
    and #$01
    beq .not_safe

    ;; DMZ: reset zone_ticks + entry penalty
    lda #0
    sta zone_ticks
    lda last_safe
    bne s_done
    lda #1
    sta last_safe
    sec
    lda score
    sbc #5
    sta score
    lda score+1
    sbc #0
    bcs s_done
    lda #0
    sta score
    sta score+1
    rts

.not_safe:
    lda #0
    sta last_safe

    inc score_tmr
    lda score_tmr
    cmp #20
    bcc s_done
    lda #0
    sta score_tmr

    lda $d000
    cmp #128
    bcc .green

    ;; Neutral zone: reset zone_ticks
    lda #0
    sta zone_ticks
    rts

.green:
    ;; Tiered scoring: +2 (0-5s), +3 (5-15s), +5 (15s+)
    inc zone_ticks
    lda zone_ticks
    cmp #38
    bcs .pts5
    cmp #13
    bcs .pts3
    lda #2
    bne .add
.pts3:
    lda #3
    bne .add
.pts5:
    lda #5
.add:
    clc
    adc score
    sta score
    lda score+1
    adc #0
    sta score+1

s_done:
    rts

;; ============================================================
;; Collision
;; ============================================================
collision_do:
    lda hit_timer
    beq c_check
    dec hit_timer
    rts

c_check:
    ;; DMZ protection: player X >= 224 (visual safe zone start)
    lda $d010
    and #$01             ; MSB set → X >= 256
    beq .c_nom
    jmp c_no
.c_nom:
    lda $d000
    cmp #224
    bcc .c_nodm
    jmp c_no
.c_nodm:

    lda $d01e
    sta c_saved        ; save — VIC clears on read
    and #$02            ; sprite 0 vs sprite 1 (enemy)
    bne .c_chk2
    jmp c_no
.c_chk2:

    ;; Distance gate: only accept collision if sprites are actually
    ;; close enough.  Hardware $D01E fires on any pixel overlap,
    ;; even edge-to-edge with a gap between the visible shapes.
    lda $d000           ; player X
    sec
    sbc $d002           ; subtract enemy X
    bcs .dx_ok
    eor #$FF            ; absolute value
    adc #1
.dx_ok:
    cmp #18              ; must be within 18 pixels
    bcs c_no

    lda $d001           ; player Y
    sec
    sbc $d003           ; subtract enemy Y
    bcs .dy_ok
    eor #$FF
    adc #1
.dy_ok:
    cmp #18              ; must be within 18 pixels
    bcs c_no

    lda c_saved
    sta $d01e           ; write back to clear

    dec lives

    lda $d000
    cmp #128
    bcc .spawn_right
    lda #110
    jmp .spawn_x
.spawn_right:
    lda #200
.spawn_x:
    sta enemy_x
    sta $d002
    lda $d010
    and #$FD
    sta $d010
    lda $d001
    cmp #140
    bcc .spawn_bottom
    lda #60
    jmp .spawn_y
.spawn_bottom:
    lda #210
.spawn_y:
    sta enemy_y
    sta $d003

    jsr death_boom         ; layered two-voice explosion + border flash

    lda #GAME_DYING
    sta state
    lda #150
    sta state_tmr
    lda #0
    sta flash_tmr
    rts

c_no:
    rts

;; ============================================================
;; Level transition — between levels, show "LEVEL X"
;; ============================================================
do_transition:
    lda #SID_WAVE_NOISE
    sta SID_CTRL_2        ; gate off engine — gstart bypassed here
    lda trans_done
    bne .t_wait
    jmp .t_draw
.t_wait:
    ;; counting down
    dec trans_tmr
    beq .t_exp
    jmp .t_rts
.t_exp:
    lda #0
    sta score_tmr          ; reset scoring state for new level
    sta zone_ticks
    sta last_safe
    sta ship_ctr
    sta ship_frame
    sta enemy_ctr
    sta enemy_frame
    lda #$03             ; enable sprites 0+1
    sta $d015
    lda #160
    sta $d000
    lda #120
    sta $d001
    lda $d010
    and #$FE
    sta $d010
    lda #100
    sta enemy_x
    sta $d002
    lda #80
    sta enemy_y
    sta $d003
    lda $d010
    and #$FD
    sta $d010
    ;; clear asteroids
    lda #0
    sta ast_active
    sta ast_msb
    lda #24
    sta ast_x
    sta ast_x+1
    sta ast_x+2
    lda #250
    sta ast_y
    sta ast_y+1
    sta ast_y+2
    sta $d004
    sta $d005
    sta $d006
    sta $d007
    sta $d008
    sta $d009
    lda #40
    sta ast_timer
    lda #255
    sta ast_warn_dir
    ;; invincibility after transition
    lda #30
    sta hit_timer
    ;; clear transition text + colour (10 cols, covers game over too)
    ldx #9
    lda #$20
.t_clr:
    sta $0400+12*40+16, x
    lda #0               ; black — restore neutral zone colour
    sta $d800+12*40+16, x
    lda #$20              ; restore space char in A for next iteration
    dex
    bpl .t_clr
    ;; back to playing
    lda #GAME_PLAYING
    sta state
    rts

.t_draw:
    inc trans_done
    ;; draw "LEVEL " at row 12, col 16
    ldx #0
.t_lp:
    lda trans_text, x
    beq .t_num
    sta $0400+12*40+16, x
    lda #1
    sta $d800+12*40+16, x
    inx
    bne .t_lp
.t_num:
    ;; draw level number (1-2 digits) at row 12, col 22
    lda trans_level
    ldx #0
.t_tens:
    cmp #10
    bcc .t_tdone
    sbc #10
    inx
    bne .t_tens          ; level < 256 so X stops at tens digit
.t_tdone:
    pha                  ; save ones digit
    txa
    beq .t_space
    clc
    adc #$30             ; tens to PETSCII digit
    jmp .t_store
.t_space:
    lda #$20             ; leading space for single digits
.t_store:
    sta $0400+12*40+16+6
    lda #1
    sta $d800+12*40+16+6
    pla
    clc
    adc #$30             ; ones to PETSCII digit
    sta $0400+12*40+16+7
    lda #1
    sta $d800+12*40+16+7
.t_rts:
    rts

trans_text: !scr "level ", 0

;; ============================================================
;; Sound tick
;; ============================================================
sound_tick:
    jsr sfx_gate_off
    lda snd_timer
    beq st_done
    dec snd_timer
    bne st_done
    lda $D404
    and #$FE
    sta $D404
st_done:
    rts

;; ============================================================
;; Level system
;; ============================================================
level_update:
    lda score+1
    beq .no_up
    lda score+1
    cmp prev_k
    beq .no_up
    bcc .no_up
    sta prev_k
    inc level
    ;; Award powerup charge at level 3+ (capped at 1)
    lda level
    cmp #3
    bcc .no_charge
    lda #1
    sta pwr_avail
.no_charge:
    lda level
    sta trans_ready      ; flag transition for gstart
    ;; Apply level difficulty
    ldx level
    cpx #6
    bcc .lv_ok
    ldx #5
.lv_ok:
    dex
    lda level_speeds, x
    sta speed_frac
    lda level_spawns, x
    sta ast_timer
    jsr sfx_coin            ; two-note chime E-5 → A-5
    ;; Enemy colour changes at level 5
    lda level
    cmp #5
    bcc .red_col
    lda #10             ; light red
    bne .set_col
.red_col:
    lda #2              ; red
.set_col:
    sta $D028
    ;; Pre-roll first asteroid direction on reaching level 2
    lda level
    cmp #2
    bne .no_up
    jsr ast_preview
.no_up:
    rts

;; ============================================================
;; Asteroid spawn table: 8 (dx, dy) pairs, dy always negative
;; ============================================================
ast_angles:
    !byte 255,-3, 255,-2, 0,-3, 1,-3    ; bottom → up: dy=-3..-1, dx=-1..1
    !byte 255,-1, 1,-2, 254,-3, 2,-3
    !byte 1,3,   255,2,  0,3,   1,2     ; top → down: dy=3..1, dx=-1..1
    !byte 255,1,  1,2,   2,3,   254,2
    !byte 254,-1, 253,-2, 254,0,  253,1  ; right → left: dx=-3..-1, dy=-1..1
    !byte 255,0,  254,1,  253,-1, 254,-2
    !byte 2,-1,   3,-2,  2,0,    3,1    ; left → right: dx=3..1, dy=-1..1
    !byte 1,0,    2,1,   3,-1,   2,-2

;; ============================================================
;; Asteroid system
;; ============================================================
ast_spawn:
    ;; Don't spawn if max asteroids already active
    lda level
    cmp #2
    bcs .sk1
    jmp .done
.sk1:
    lda #0
    sta ast_count
    lda ast_active
    ldx #2
.cnt_lp:
    lsr
    bcc .cnt_nx
    inc ast_count
.cnt_nx:
    dex
    bpl .cnt_lp
    
    lda level
    cmp #2
    bne .chk3
    lda #1
    bne .cmp_ct
.chk3:
    cmp #3
    bne .chk4
    lda #1
    bne .cmp_ct
.chk4:
    cmp #4
    bne .chk5
    lda #2
    bne .cmp_ct
.chk5:
    lda #3
.cmp_ct:
    cmp ast_count
    bne .sk2
    jmp .done
.sk2:
    bcs .sk3
    jmp .done
.sk3:

    ;; Use pre-rolled direction if available (position already computed)
    lda ast_warn_dir
    cmp #255
    beq .random_pick
    lda ast_next_vx
    sta ast_vx
    lda ast_next_vy
    sta ast_vy
    lda ast_warn_x
    sta ast_tmp2
    lda ast_warn_y
    sta ast_tmp
    lda #255
    sta ast_warn_dir
    jmp .reset_x
.random_pick:

    ;; CIA timer + raster — independent of LFSR cycle
    lda $dc04
    eor $d012
    and #$1F
    asl
    tax
    lda ast_angles, x
    sta ast_vx
    lda ast_angles+1, x
    sta ast_vy

.determine_edge:
    ;; Determine spawn edge from direction
    ;; Bottom spawn: dy negative (bits 6-7 of dy set = $80-$FF)
    lda ast_vy
    bpl .not_bottom      ; positive dy → not bottom
    ;; Bottom: Y=210, random X
    lda #210
    sta ast_tmp          ; reuse as Y position
    jsr lfsr_tick
    and #$7F
    adc #40
    sta ast_tmp2
    jmp .reset_x

.not_bottom:
    ;; Top spawn: dy positive → Y=50, random X
    lda ast_vx
    bmi .not_top         ; dx negative → left or right spawn
    ;; Check if dy is positive and we're top-spawning
    lda ast_vy
    cmp #1
    bcc .not_top         ; dy=0 → edge spawn, treat as right/left
    lda #110
    sta ast_tmp
    jsr lfsr_tick
    and #$7F
    adc #40
    sta ast_tmp2
    jmp .reset_x

.not_top:
    ;; Check dx: negative → right edge, positive → left edge
    lda ast_vx
    bpl .left_spawn
    ;; Right edge: X=255, random Y 50-229
    lda #255
    sta ast_tmp2
    jsr lfsr_tick
    and #$7F
    adc #50
    cmp #230
    bcc .ry_ok
    lda #229
.ry_ok:
    sta ast_tmp
    jmp .reset_x

.left_spawn:
    ;; Left edge: X=24, random Y 50-229
    lda #24
    sta ast_tmp2
    jsr lfsr_tick
    and #$7F
    adc #50
    cmp #230
    bcc .ly_ok
    lda #229
.ly_ok:
    sta ast_tmp
    jmp .reset_x

    ;; Find free asteroid slot (X always reset to 0 on entry)
.reset_x:
    ldx #0
.find_lp:
    lda ast_active
    cpx #0
    bne .chk1
    and #$01
    beq .found
    bne .nxt
.chk1:
    cpx #1
    bne .chk2
    and #$02
    beq .found
    bne .nxt
.chk2:
    and #$04
    beq .found
.nxt:
    inx
    cpx #3
    bne .find_lp
    rts

.found:
    ;; Activate this slot
    lda ast_active
    cpx #0
    bne .s1
    ora #$01
    bne .sav
.s1:
    cpx #1
    bne .s2
    ora #$02
    bne .sav
.s2:
    ora #$04
.sav:
    sta ast_active

    ;; Speed clamp — levels 1-4 cap both velocity components at
    ;; |2| px/frame; the ±3 variants stay reserved for level 5+
    ;; (the max difficulty tier).  Applies to both the random pick
    ;; and the radar pre-rolled path — direction signs are untouched,
    ;; so the radar warning stays accurate.
    lda level
    cmp #5
    bcs .no_speed_clamp
    lda ast_vx
    cmp #3
    bne .vx_neg
    lda #2
    sta ast_vx
    jmp .vy_clamp
.vx_neg:
    cmp #253              ; -3
    bne .vy_clamp
    lda #254              ; -2
    sta ast_vx
.vy_clamp:
    lda ast_vy
    cmp #3
    bne .vy_neg
    lda #2
    sta ast_vy
    jmp .no_speed_clamp
.vy_neg:
    cmp #253
    bne .no_speed_clamp
    lda #254
    sta ast_vy
.no_speed_clamp:

    ;; Slot 0 rocks are level-coloured: level 2 yellow (7), level 3+
    ;; white (1).  Slots 1/2 keep their fixed orange/light-red from
    ;; do_init.  Written at spawn time so it survives do_init re-runs
    ;; after transitions.
    cpx #0
    bne .no_slot0_col
    lda level
    cmp #3
    bcc .slot0_yellow
    lda #1
    bne .slot0_set
.slot0_yellow:
    lda #7
.slot0_set:
    sta $d029
.no_slot0_col:

    ;; Store position + velocity
    lda ast_vx
    sta ast_dx, x
    lda ast_vy
    sta ast_dy, x
    lda ast_tmp2          ; X position
    sta ast_x, x
    lda ast_tmp           ; Y position
    sta ast_y, x
    ;; Write initial VIC registers (X and Y per slot)
    lda ast_tmp2
    cpx #0
    bne .w1
    sta $d004
    lda ast_tmp
    sta $d005
    jmp .w_done
.w1:
    cpx #1
    bne .w2
    sta $d006
    lda ast_tmp
    sta $d007
    jmp .w_done
.w2:
    sta $d008
    lda ast_tmp
    sta $d009
.w_done:
    ;; Clear MSB for this asteroid
    lda ast_msb
    cpx #0
    bne .m1
    and #$FE
    jmp .mb
.m1:
    cpx #1
    bne .m2
    and #$FD
    jmp .mb
.m2:
    and #$FB
.mb:
    sta ast_msb
    sta ast_msb
    jsr lfsr_tick       ; shuffle for next spawn
    jsr ast_preview
    rts

.done:
    jsr lfsr_tick       ; shuffle for next spawn
    rts
ast_tmp: !byte 0
ast_tmp2: !byte 0

;; ============================================================
;; Pre-roll next asteroid direction + position for radar warning
;; ============================================================
ast_preview:
    lda state
    cmp #GAME_PLAYING
    beq .ap_go
    rts
.ap_go:

    ;; reset radar edge detect for new warning
    lda #0
    sta radar_was

    ;; CIA timer + raster — independent of LFSR cycle
    lda $dc04
    eor $d012
    and #$1F
    asl
    tax
    lda ast_angles, x
    sta ast_next_vx
    lda ast_angles+1, x
    sta ast_next_vy

    ;; Determine direction AND compute spawn position
    lda ast_next_vy
    bpl .ap_nb

    ;; BOTTOM: Y=210, random X 40-167
    lda #0
    sta ast_warn_dir
    lda #210
    sta ast_warn_y
    jsr lfsr_tick
    and #$7F
    adc #40
    sta ast_warn_x
    jmp .ap_tail

.ap_nb:
    lda ast_next_vx
    bmi .ap_nt
    lda ast_next_vy
    cmp #1
    bcc .ap_nt

    ;; TOP: Y=50, random X 40-167
    lda #1
    sta ast_warn_dir
    lda #110
    sta ast_warn_y
    jsr lfsr_tick
    and #$7F
    adc #40
    sta ast_warn_x
    jmp .ap_tail

.ap_nt:
    lda ast_next_vx
    bpl .ap_lft

    ;; RIGHT: X=255, random Y 50-229
    lda #2
    sta ast_warn_dir
    lda #255
    sta ast_warn_x
    jsr lfsr_tick
    and #$7F
    adc #50
    cmp #230
    bcc .ap_ry
    lda #229
.ap_ry:
    sta ast_warn_y
    jmp .ap_tail

.ap_lft:
    ;; LEFT: X=24, random Y 50-229
    lda #3
    sta ast_warn_dir
    lda #24
    sta ast_warn_x
    jsr lfsr_tick
    and #$7F
    adc #50
    cmp #230
    bcc .ap_ly
    lda #229
.ap_ly:
    sta ast_warn_y

.ap_tail:
    jsr lfsr_tick
.ap_done:
    rts

ast_update:
    ;; Decrement spawn timer
    lda ast_timer
    beq .spwn
    dec ast_timer
    bne .spwn_d
.spwn:
    jsr ast_spawn
    ldx level
    cpx #6
    bcc .a_ok
    ldx #5
.a_ok:
    dex
    lda level_spawns, x
    sta ast_timer
.spwn_d:

    ;; Move active asteroids
    ldx #2
.mv_lp:
    lda ast_active
    cpx #0
    bne .mv_c1
    and #$01
    bne .mvs1
    jmp .mv_nx
.mvs1:
    jmp .do_move
.mv_c1:
    cpx #1
    bne .mv_c2
    and #$02
    bne .mvs2
    jmp .mv_nx
.mvs2:
    jmp .do_move
.mv_c2:
    and #$04
    bne .mvs3
    jmp .mv_nx
.mvs3:
.do_move:

    ;; Move Y (always up = add negative dy = subtract)
    lda ast_y, x
    clc
    adc ast_dy, x
    sta ast_y, x

    ;; Move X (signed addition)
    lda ast_dx, x
    bmi .dx_neg
    clc
    lda ast_x, x
    adc ast_dx, x
    sta ast_x, x
    bcc .no_msb
    ;; Set MSB if carry (X >= 256)
    lda ast_msb
    cpx #0
    bne .ms1
    ora #$01
    bne .ms_sv
.ms1:
    cpx #1
    bne .ms2
    ora #$02
    bne .ms_sv
.ms2:
    ora #$04
.ms_sv:
    sta ast_msb
    jmp .no_msb
.dx_neg:
    clc
    lda ast_x, x
    adc ast_dx, x
    sta ast_x, x
    ;; Clear MSB for this slot
    lda ast_msb
    cpx #0
    bne .nms1
    and #$FE
    jmp .nmsv
.nms1:
    cpx #1
    bne .nms2
    and #$FD
    jmp .nmsv
.nms2:
    and #$FB
.nmsv:
    sta ast_msb
.no_msb:

    ;; Write to VIC registers (indexed fall-through bugfix)
    cpx #0
    bne .wx1
    lda ast_x
    sta $d004
    lda ast_y
    sta $d005
    jmp .ds_chk
.wx1:
    cpx #1
    bne .wx2
    lda ast_x, x
    sta $d006
    lda ast_y, x
    sta $d007
    jmp .ds_chk
.wx2:
    lda ast_x, x
    sta $d008
    lda ast_y, x
    sta $d009

.ds_chk:
    ;; Check if off-screen (Y < 10 or Y > 235)
    lda ast_y, x
    cmp #10
    bcc .despawn
    cmp #236
    bcc .ds_xchk
    bcs .despawn

.ds_xchk:
    ;; Check X despawn — only left edge needed (right-edge asteroids
    ;; will hit Y bounds if dy≠0, or reach X<8 if moving left with dy=0)
    lda ast_x, x
    cmp #8
    bcc .despawn

    jmp .mv_nx

.despawn:
    lda ast_active
    cpx #0
    bne .ds1
    and #$FE
    bne .ds_sv
.ds1:
    cpx #1
    bne .ds2
    and #$FD
    bne .ds_sv
.ds2:
    and #$FB
.ds_sv:
    sta ast_active

.mv_nx:
    dex
    bmi .mv_done
    jmp .mv_lp
.mv_done:
    ;; Re-enable asteroid sprites in $D015 (after spawn + movement)
    lda state
    cmp #GAME_PLAYING
    bne .no_fix
    lda $d015
    and #$E3               ; keep bits 0-1, clear asteroid bits 2-4
    sta $d015
    lda ast_active
    asl
    asl                   ; shift to bits 2-4
    ora $d015
    sta $d015
.no_fix:
    rts

ast_collision:
    ;; Don't double-fire if enemy collision already triggered
    lda state
    cmp #GAME_PLAYING
    bne .ac_done

    ;; DMZ protection: player X >= 224
    lda $d010
    and #$01
    bne .ac_done
    lda $d000
    cmp #224
    bcs .ac_done

    lda hit_timer
    beq .ac_chk
.ac_done:
    rts
.ac_chk:
    lda c_saved
    and #$1C          ; sprite 0 vs sprite 2/3/4
    bne .ac_hit
    rts
.ac_hit:
    ;; Distance gate — same as enemy
    ldy #2              ; check each asteroid slot
.acd_lp:
    lda ast_active
    ;; Check if this slot is active and within range
    cpy #0
    bne .acd1
    and #$01
    beq .acd_nx
    lda $d000
    sec
    sbc $d004
    bcs .acd_ax0
    eor #$FF
    adc #1
.acd_ax0:
    cmp #18
    bcc .acd_y0
    bcs .acd_nx
.acd_y0:
    lda $d001
    sec
    sbc $d005
    bcs .acd_ay0
    eor #$FF
    adc #1
.acd_ay0:
    cmp #18
    bcc .ac_real_hit
    jmp .acd_nx

.acd1:
    cpy #1
    bne .acd2
    and #$02
    beq .acd_nx
    lda $d000
    sec
    sbc $d006
    bcs .acd_ax1
    eor #$FF
    adc #1
.acd_ax1:
    cmp #18
    bcc .acd_y1
    bcs .acd_nx
.acd_y1:
    lda $d001
    sec
    sbc $d007
    bcs .acd_ay1
    eor #$FF
    adc #1
.acd_ay1:
    cmp #18
    bcc .ac_real_hit
    jmp .acd_nx

.acd2:
    and #$04
    beq .acd_nx
    lda $d000
    sec
    sbc $d008
    bcs .acd_ax2
    eor #$FF
    adc #1
.acd_ax2:
    cmp #18
    bcc .acd_y2
    bcs .acd_nx
.acd_y2:
    lda $d001
    sec
    sbc $d009
    bcs .acd_ay2
    eor #$FF
    adc #1
.acd_ay2:
    cmp #18
    bcc .ac_real_hit

.acd_nx:
    dey
    bmi .acd_done
    jmp .acd_lp
.acd_done:
    rts

.ac_real_hit:
    lda c_saved
    sta $d01e

    dec lives
    lda #GAME_DYING
    sta state
    lda #150
    sta state_tmr
    lda #0
    sta flash_tmr
    sta hit_timer

    jsr death_boom         ; layered two-voice explosion + border flash
    rts

;; ============================================================
;; Radar: sprite 5 at exact spawn position
;; ============================================================
radar_do:
    lda state
    cmp #GAME_PLAYING
    bne .r_hide_w

    lda ast_warn_dir
    cmp #255
    beq .r_hide_w

    ;; edge: was hidden, now visible → radar ping
    lda radar_was
    bne .r_go
    inc radar_was
    jsr sfx_boop

.r_go:

    lda ast_warn_dir
    beq .r_bot
    cmp #1
    beq .r_top
    cmp #2
    beq .r_rgt

    ;; LEFT edge: pin X=24, exact Y
    lda #24
    sta $d00a
    lda ast_warn_y
    sta $d00b
    bne .r_ena

.r_rgt:
    ;; RIGHT edge: pin X=240 (just before DMZ), exact Y
    lda #230
    sta $d00a
    lda ast_warn_y
    sta $d00b
    bne .r_ena

.r_top:
    ;; TOP edge: pin Y=60, exact X
    lda ast_warn_x
    sta $d00a
    lda #59
    sta $d00b
    bne .r_ena

.r_bot:
    ;; BOTTOM edge: pin Y=229, exact X
    lda ast_warn_x
    sta $d00a
    lda #229
    sta $d00b

.r_ena:
    lda $d015
    ora #$20
    sta $d015
    rts

.r_hide_w:
    lda #0
    sta radar_was
    ;; fall through to hide sprite
.r_hide:
    lda $d015
    and #$DF
    sta $d015
    rts


dmz_colors:  !byte 6, 14, 3, 4, 8, 10, 15, 1

lfsr_tick:
    lda dmz_seed
    lsr
    bcc d_noe
    eor #$2D
d_noe:  sta dmz_seed
    bne d_done          ; never let seed be 0 (terminal state)
    lda #$5A
    sta dmz_seed
d_done:
    rts

dmz_init:
    lda #1
    sta d_ri
di_row:
    lda d_ri
    jsr d_mul40
    clc
    lda $57
    adc #28
    sta $57
    lda $58
    adc #>$D800
    sta $58
    ldy #11
di_col:
    jsr lfsr_tick
    and #$07
    tax
    lda dmz_colors, x
    sta ($57), y
    dey
    bpl di_col
    inc d_ri
    lda d_ri
    cmp #25
    bne di_row
    rts
d_ri: !byte 0

dmz_do:
    ;; Refresh every 3rd frame so the static shimmers, not strobes.
    dec dmz_timer
    bne d_skip
    lda #3
    sta dmz_timer

    ;; Write a random colour to all 288 safe-zone cells.
    ;; Uses LFSR for per-cell randomness — creates TV-static interference.
    lda #1
    sta d_ri
dr_row:
    lda d_ri
    jsr d_mul40
    clc
    lda $57
    adc #28
    sta $57
    lda $58
    adc #>$D800
    sta $58

    ldy #11
dr_col:
    jsr lfsr_tick
    and #$0F            ; random colour 0-15
    sta ($57), y
    dey
    bpl dr_col

    inc d_ri
    lda d_ri
    cmp #25
    bne dr_row
d_skip:
    rts

d_mul40:
    sta d_t1
    asl
    asl
    asl
    sta $57             ; row * 8
    lda d_t1
    sta d_m32
    lda #0
    sta d_m32h
    asl d_m32
    rol d_m32h
    asl d_m32
    rol d_m32h
    asl d_m32
    rol d_m32h
    asl d_m32
    rol d_m32h
    asl d_m32
    rol d_m32h
    clc
    lda d_m32
    adc $57
    sta $57
    lda d_m32h
    adc #0
    sta $58
    rts
d_t1:   !byte 0
d_m32:  !byte 0
d_m32h: !byte 0
d_tmp:  !byte 0

;; -- Rock sprite data (asteroid) --
;; ============================================================
;; Cheat: press SPACE to cycle through levels 1-5
;; ============================================================
cheat_keys:
    lda #$7f
    sta $dc00
    lda $dc01
    and #$10             ; 0 = SPACE pressed
    beq chk_pressed
    jmp chk_up
chk_pressed:

    ;; SPACE pressed — was it NOT pressed last frame?
    lda cheat_spc
    bne chk_edge           ; was not pressed → edge!
    rts                    ; holding SPACE, no new edge

chk_edge:
    ;; Advance level 1→2→3→4→5→1
    inc level
    lda level
    cmp #6
    bcc chk_set
    lda #1
    sta level

chk_set:
    ldx level
    dex
    lda level_speeds, x
    sta speed_frac
    txa
    asl
    tax
    lda level_scores, x
    sta score
    lda level_scores+1, x
    sta score+1
    sta prev_k           ; match score high byte so level_update skips
    ora score
    beq chk_clr            ; level 1: no chirp
    jsr chk_sid
    lda level
    sta trans_ready      ; flag transition for gstart
    ;; Enemy colour at level 5
    lda level
    cmp #5
    bcc .chk_red
    lda #10
    bne .chk_setc
.chk_red:
    lda #2
.chk_setc:
    sta $D028

chk_clr:
    lda #0
    sta cheat_spc
    ;; Spawn asteroid if below level max
    lda level
    cmp #2
    bcs .notl1
    jmp chk_rts
.notl1:
    ;; Count active and compare with level max
    lda ast_active
    ldy #0
    lsr
    bcc .ca
    iny
.ca:lsr
    bcc .cb
    iny
.cb:lsr
    bcc .cc
    iny
.cc:
    lda level
    cmp #3
    bcs .ck4p
    cpy #1              ; levels 2-3: max 1
    bcc .un_a
    jmp chk_rts
.un_a:
    bcc .go
.ck4p:
    cmp #5
    bcs .ck5p
    cpy #2              ; level 4: max 2
    bcc .un_b
    jmp chk_rts
.un_b:
    bcc .go
.ck5p:
    cpy #3              ; level 5+: max 3
    bcc .un_c
    jmp chk_rts
.un_c
.go:
    ;; Find a free asteroid slot
    ldx #0
.fnd:
    lda ast_active
    cpx #0
    bne .f1
    and #$01
    beq .fnd_ok
    bne .fnxt
.f1:
    cpx #1
    bne .f2
    and #$02
    beq .fnd_ok
    bne .fnxt
.f2:
    and #$04
    beq .fnd_ok
.fnxt:
    inx
    cpx #3
    bne .fnd
    jmp chk_rts          ; all slots full

.fnd_ok:
    ;; Shuffle with raster for variety
    lda $d012
    lsr
    bcc .ts1
    jsr lfsr_tick
.ts1:
    lsr
    bcc .ts2
    jsr lfsr_tick
.ts2:
    ;; Pick random angle
    jsr lfsr_tick
    and #$0F             ; 16 angles in full table
    asl
    tay
    lda ast_angles, y
    sta ast_dx, x
    lda ast_angles+1, y
    sta ast_dy, x
    ;; Spawn edge from stored velocity
    lda ast_dy, x
    bmi bot0              ; dy < 0 → bottom
    beq chkdx0            ; dy == 0 → left/right
    jmp top0              ; dy > 0 → top
chkdx0:
    lda ast_dx, x
    bmi rt0               ; dx < 0 → right
    jmp lt0               ; dx >= 0 → left
bot0:
    ;; Bottom spawn
    jsr lfsr_tick
    and #$7F
    adc #40
    sta ast_x, x
    lda #210
    sta ast_y, x
    jmp .fv_reg
rt0:
    ;; Right edge
    lda #255
    sta ast_x, x
    jsr lfsr_tick
    and #$7F
    adc #50
    cmp #230
    bcc .tby
    lda #229
.tby:
    sta ast_y, x
    jmp .fv_reg
top0:
    ;; Top spawn
    jsr lfsr_tick
    and #$7F
    adc #40
    sta ast_x, x
    lda #110
    sta ast_y, x
    jmp .fv_reg
lt0:
    ;; Left edge
    lda #24
    sta ast_x, x
    jsr lfsr_tick
    and #$7F
    adc #50
    cmp #230
    bcc .tly
    lda #229
.tly:
    sta ast_y, x
.fv_reg:
    ;; Fix VIC registers for slot
    cpx #0
    bne .fx1
    lda ast_x
    sta $d004
    lda ast_y
    sta $d005
    jmp .fact
.fx1:
    cpx #1
    bne .fx2
    lda ast_x, x
    sta $d006
    lda ast_y, x
    sta $d007
    jmp .fact
.fx2:
    lda ast_x, x
    sta $d008
    lda ast_y, x
    sta $d009

.fact:
    ;; Set the active bit for this slot
    lda ast_active
    cpx #0
    bne .fa1
    ora #$01
    bne .fas
.fa1:
    cpx #1
    bne .fa2
    ora #$02
    bne .fas
.fa2:
    ora #$04
.fas:
    sta ast_active
    ;; Enable sprite in $d015
    lda $d015
    cpx #0
    bne .fd1
    ora #$04
    bne .fds
.fd1:
    cpx #1
    bne .fd2
    ora #$08
    bne .fds
.fd2:
    ora #$10
.fds:
    sta $d015
    ;; Clear MSB for this slot
    lda ast_msb
    cpx #0
    bne .fm1
    and #$FE
    bne .fms
.fm1:
    cpx #1
    bne .fm2
    and #$FD
    bne .fms
.fm2:
    and #$FB
.fms:
    sta ast_msb
    ;; Quick respawn timer
    lda #1
    sta ast_timer
chk_rts:
    rts

chk_up:
    lda #$10
    sta cheat_spc          ; remember: SPACE not pressed
    rts
level_speeds: !byte 128, 128, 128, 154, 179     ; px/s: 25, 25, 25, 30, 35
level_spawns: !byte 40, 40, 30, 25, 20            ; asteroid spawn interval
level_scores: !word 0, 1000, 2000, 3000, 4000     ; score per level (cheat)

chk_sid:
    jmp sfx_coin           ; two-note chime E-5 → A-5


;; --- Guard: the code region must end before the base sprite data ---
;; (emitted at $2000 by codegen).  Growing game_logic past $2000
;; silently corrupts the strings/data below — fail the build instead.
!if * > $2000 {
    !error "game_logic overruns $2000 sprite data — free up code space"
}

;; --- Sprite animation frames ---
;; Ship frame 1 (4 directions) — blocks $85-$88
;; Frame 1 vs frame 0 ("surge" pose): the diagonal exhaust streak
;; shifts one step along the hull (right/left) or the V-shaped engine
;; flare cuts out (up/down), and the nose claw pinches 1px toward the
;; body.  l1/d1 are hand-drawn variants matching the base art's
;; left/down orientation — not mechanical mirrors of r1/u1.
* = $2140   ; $85: ship_r1
    !bin "assets/sprites/ship_r1.spr"
* = $2180   ; $86: ship_l1
    !bin "assets/sprites/ship_l1.spr"
* = $21C0   ; $87: ship_u1
    !bin "assets/sprites/ship_u1.spr"
* = $2200   ; $88: ship_d1
    !bin "assets/sprites/ship_d1.spr"
;; Enemy frames 1-6 — blocks $89-$8E (7-frame cycle with frame 0)
;; Hand-drawn cycle: the tentacles spread progressively (web opening
;; wider, tips shifting outward); frame 6 is the widest and the cycle
;; wraps back to the rest pose of frame 0.  Mantle and eyes stay
;; fixed throughout.
;; Block $8F ($23C0) is free — reserved for future animation frames.
* = $2240   ; $89: skull1
    !bin "assets/sprites/skull1.spr"
* = $2280   ; $8A: skull2
    !bin "assets/sprites/skull2.spr"
* = $22C0   ; $8B: skull3
    !bin "assets/sprites/skull3.spr"
* = $2300   ; $8C: skull4
    !bin "assets/sprites/skull4.spr"
* = $2340   ; $8D: skull5
    !bin "assets/sprites/skull5.spr"
* = $2380   ; $8E: skull6
    !bin "assets/sprites/skull6.spr"

;; Rock sprite data (asteroid) — block $90
* = $2400
    !bin "assets/sprites/rock.spr"

;; Radar indicator sprite data (crosshair target) — block $91
* = $2440
    !byte $00,$00,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$7C,$00
    !byte $00,$92,$00
    !byte $00,$82,$00
    !byte $3F,$EF,$F0
    !byte $00,$82,$00
    !byte $00,$92,$00
    !byte $00,$7C,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$10,$00
    !byte $00,$00,$00
    !byte $01

;; Splash screen text — lives after the sound presets at $2900, clear
;; of both the code region (guarded at $2000 above) and sprite data.
;; (Previously emitted at the end of the code region; it crossed the
;; $2000 boundary when the code grew and got overwritten by ship_r.spr.)
* = $2900
ds_title:  !scr "last star system", 0
ds_press:  !scr "press fire to play", 0
ds_credit: !scr "gpowerf 2026", 0

;; ============================================================
;; Ship engine (voice 2) — direction-tuned noise rumble
;; ============================================================
;; Called every frame from gstart.  Gates on while moving in the
;; PLAYING state.  Noise waveform at low frequency reads as
;; "spaceship thrust" white-noise rumble (2600 Asteroids style);
;; the base frequency comes from engine_freqs[player_dir] and the
;; framework LFSR (random) churns the low byte every frame so the
;; exhaust sounds alive instead of static:
;;   right ~ mid rumble, left ~ deeper rumble,
;;   up ~ hissier thrust, down ~ deepest churn.
;; Voice 2 is never touched by sfx_gate_off (voices 1+3 only), so
;; one-shot presets can't clobber the drone.  do_transition gates it
;; off explicitly because gstart is bypassed there.
* = $2940
engine_do:
    lda boom_tmr
    bne .skip               ; the death boom owns voice 2 — yield
    lda state
    cmp #GAME_PLAYING
    bne .off
    lda player_moving
    beq .off
    lda player_dir
    asl
    tax
    lda random              ; frame LFSR — engine churn
    and #$7F
    clc
    adc engine_freqs, x     ; base lo + 0..$7F wiggle
    sta SID_FREQ_LO_2
    lda engine_freqs+1, x
    adc #0                  ; carry into hi
    sta SID_FREQ_HI_2
    lda #$08
    sta SID_ATK_DEC_2       ; attack 0, decay 8
    lda #$80
    sta SID_SUST_REL_2      ; sustain 8 (volume), release 0
    lda #SID_WAVE_NOISE | SID_GATE_ON
    sta SID_CTRL_2
    rts
.off:
    lda #SID_WAVE_NOISE
    sta SID_CTRL_2          ; gate off + release 0 = instant silence
.skip:
    rts

engine_freqs:
    !word $2600   ; right — mid rumble
    !word $2E00   ; left  — deeper rumble
    !word $1C00   ; up    — hissier thrust
    !word $4000   ; down  — deepest churn


;; ============================================================
;; Splash screen (do_splash + splash_wait + splash_bars +
;; draw_splash) — relocated to the extended RAM area: the
;; $0801-$2000 code region was full (see the guard above the
;; sprite data) and the splash runs once per boot.
* = $2A00
;; ============================================================
do_splash:
    lda #$00
    sta $d015             ; disable all sprites during splash
    lda splash_done
    bne splash_wait
    inc splash_done
    jsr draw_splash
    ;; Fall through to splash frame loop — we own the frame now,
    ;; main_loop's behaviors_update never runs during splash.

splash_wait:
    ;; Frame sync — own wait loop, bypassing main_loop entirely
    ;; so behaviors_update never runs during splash.
    lda frame_ready
    beq splash_wait
    lda #0
    sta frame_ready

    ;; DMZ-style side bars: shimmer columns 0-5 and 34-39
    jsr splash_bars

    ;; Check SPACE to start
    lda #$7f
    sta $dc00
    lda $dc01
    and #$10             ; 0 = SPACE pressed
    beq .ds_start

    ;; Check joystick port 2 fire
    lda #$00
    sta $dc02            ; set port A all inputs
    lda $dc00
    and #$10             ; 0 = fire pressed
    tax                  ; save fire state
    lda #$ff
    sta $dc02            ; restore keyboard mode
    txa
    beq .ds_start        ; fire pressed → start
    ;; Testability hook: if state was changed externally (VICE monitor
    ;; tests poke state), exit the splash loop.  Inert during real play —
    ;; nothing in the game itself writes state while splashing.
    lda state
    cmp #GAME_SPLASH
    bne .ds_start
    jmp splash_wait

.ds_start:
    lda #0
    sta init_done         ; force do_init to re-run (overwrites splash with game screen)
    lda #$03             ; enable sprites 0+1
    sta $d015
    lda #GAME_PLAYING
    sta state
.ds_rts:
    rts

;; ============================================================
;; Splash side bars — DMZ-style shimmer on left and right edges
;; ============================================================
splash_bars:
    dec spl_tmr
    bne .sb_done
    lda #3
    sta spl_tmr           ; refresh every 3rd frame

    lda #0
    sta spl_row
.sb_row:
    lda spl_row
    jsr d_mul40           ; $57/$58 = row * 40
    clc
    lda $57
    adc #<$d800           ; color RAM base
    sta $57
    lda $58
    adc #>$d800
    sta $58

    ;; Left bar: columns 0-5
    ldy #5
.sb_l:
    jsr lfsr_tick
    and #$0F
    sta ($57), y
    dey
    bpl .sb_l

    ;; Right bar: columns 34-39
    ldy #39
.sb_r:
    jsr lfsr_tick
    and #$0F
    sta ($57), y
    dey
    cpy #33
    bne .sb_r

    inc spl_row
    lda spl_row
    cmp #25
    bne .sb_row
.sb_done:
    rts

spl_tmr:  !byte 1        ; countdown to next refresh
spl_row:  !byte 0        ; current row index

draw_splash:
    ;; Fill screen: solid blocks with black foreground (columns 6-33
    ;; stay black; side bars at 0-5 and 34-39 overwritten with
    ;; DMZ-style shimmer by splash_bars)
    ldx #0
    lda #$a0
.s_clr:
    sta $0400, x
    sta $0500, x
    sta $0600, x
    sta $06e8, x
    inx
    bne .s_clr

    ;; Color RAM: all black — bars at 0-5 and 34-39 overwritten each
    ;; frame by splash_bars, middle stays black for text.
    ldx #0
    lda #0
.s_col:
    sta $d800, x
    sta $d900, x
    sta $da00, x
    sta $dae8, x
    inx
    bne .s_col

    ;; Title in white at row 10, col 12
    ldx #0
.s_tit:
    lda ds_title, x
    beq .s_sub
    sta $0400+10*40+12, x
    lda #1
    sta $d800+10*40+12, x
    inx
    bne .s_tit

.s_sub:
    ;; Subtitle in light gray at row 14, col 11
    ldx #0
.s_slp:
    lda ds_press, x
    beq .s_cred
    sta $0400+14*40+11, x
    lda #15
    sta $d800+14*40+11, x
    inx
    bne .s_slp

.s_cred:
    ;; Credit in light gray at row 22, col 14
    ldx #0
.s_clp:
    lda ds_credit, x
    beq .s_done
    sta $0400+22*40+14, x
    lda #15
    sta $d800+22*40+14, x
    inx
    bne .s_clp

.s_done:
    rts

;; ============================================================
;; Death boom — layered explosion, 60 frames
;; ============================================================
;; Triggered once by .ac_real_hit / collision_do.  boom_tick (called
;; from gstart's sound section every frame, so it keeps running
;; through the DYING state) sweeps both voices and flashes the border:
;;   voice 3 noise:  hi byte $18 -> $7E — harsh crack descending
;;                   into a deep rumble (computed from the 60-frame
;;                   countdown, clamped at $7E), sustain fades out
;;                   over the last 24 frames
;;   voice 2 pulse:  hi byte $04 -> $40 — sub thump dropping from
;;                   ~240 Hz to 60 Hz
;;   border:         red/white flash at 25 Hz for the first 40
;;                   frames, then back to normal (11)
;; Sweeps are plain STA stores — SID registers are write-only, so
;; INC (read-modify-write) reads bus garbage on real hardware.
;; Voice 2 is free here: engine_do yields while boom_tmr > 0, and
;; sfx_gate_off only manages voices 1+3.  When inactive, boom_tick
;; does nothing at all — it must never gate voice 3 in idle or the
;; enemy-respawn sfx_explosion would be killed a frame later.
death_boom:
    lda #60
    sta boom_tmr
    lda #$0F
    sta SID_VOL_MODE
    ;; Voice 3: noise, harsh start, loud
    lda #$00
    sta SID_FREQ_LO_3
    lda #$18
    sta SID_FREQ_HI_3        ; high noise = sharp crack
    lda #$00
    sta SID_ATK_DEC_3        ; instant attack
    lda #$F0
    sta SID_SUST_REL_3       ; sustain F (loud), release 0
    lda #SID_WAVE_NOISE | SID_GATE_ON
    sta SID_CTRL_3
    ;; Voice 2: pulse sub-drop, starts high (~240 Hz)
    lda #$00
    sta SID_PW_LO_2
    lda #$08
    sta SID_PW_HI_2
    lda #$00
    sta SID_FREQ_LO_2
    lda #$04
    sta SID_FREQ_HI_2        ; ~240 Hz thump
    lda #$00
    sta SID_ATK_DEC_2
    lda #$F0
    sta SID_SUST_REL_2
    lda #SID_WAVE_PULSE | SID_GATE_ON
    sta SID_CTRL_2
    rts

boom_tick:
    lda boom_tmr
    beq .bt_done             ; inactive — never touch the SID
    dec boom_tmr
    beq .bt_off              ; just finished this frame
    ;; Sweeps are computed from the countdown and stored with plain
    ;; STA — never INC a SID register (read-modify-write on a
    ;; write-only register returns bus garbage on real hardware).
    ;; Voice 3 noise hi: $18 + elapsed*2, clamped at $7E
    lda #60
    sec
    sbc boom_tmr
    asl
    clc
    adc #$18
    cmp #$7E
    bcc .bt_v3s
    lda #$7E
.bt_v3s:
    sta SID_FREQ_HI_3
    ;; Voice 2 pulse hi: $05 + elapsed (reaches $40 at the end)
    lda #60
    sec
    sbc boom_tmr
    clc
    adc #$05
    sta SID_FREQ_HI_2
.bt_tail:
    ;; Fade the noise sustain over the last 24 frames (0..5)
    lda boom_tmr
    cmp #24
    bcs .bt_flash
    lsr
    lsr                     ; /4 -> sustain nibble 0..5
    sta SID_SUST_REL_3      ; sustain = level, release 0
.bt_flash:
    ;; Border flash: red/white at 25 Hz while tmr > 20
    lda boom_tmr
    cmp #21
    bcc .bt_normal
    and #$02
    bne .bt_white
    lda #2
    bne .bt_set
.bt_white:
    lda #1
.bt_set:
    sta $d020
    rts
.bt_normal:
    lda #11
    sta $d020
.bt_done:
    rts
.bt_off:
    ;; Boom finished: silence both voices, normal border
    lda #SID_WAVE_NOISE
    sta SID_CTRL_3
    lda #SID_WAVE_PULSE
    sta SID_CTRL_2
    lda #11
    sta $d020
    rts
