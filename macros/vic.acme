;; vic.acme — VIC-II macros (screen, sprites, raster, colors)

VIC_BASE = $d000

SPRITE_X_LO    = VIC_BASE + $00
SPRITE_Y       = VIC_BASE + $01
SPRITE_X_HI    = VIC_BASE + $10
SCREEN_CTRL1   = VIC_BASE + $11
RASTER_LINE    = VIC_BASE + $12
LIGHTPEN_X     = VIC_BASE + $13
LIGHTPEN_Y     = VIC_BASE + $14
SPRITE_ENABLE  = VIC_BASE + $15
SCREEN_CTRL2   = VIC_BASE + $16
SPRITE_EXPAND_Y = VIC_BASE + $17
MEMORY_PTRS    = VIC_BASE + $18
IRQ_STATUS     = VIC_BASE + $19
IRQ_ENABLE     = VIC_BASE + $1a
SPRITE_PRIORITY = VIC_BASE + $1b
SPRITE_MULTICOLOR = VIC_BASE + $1c
SPRITE_EXPAND_X = VIC_BASE + $1d
SPRITE_SPRITE_COLL = VIC_BASE + $1e
SPRITE_DATA_COLL = VIC_BASE + $1f
BORDER_COLOR   = VIC_BASE + $20
BACKGROUND_COLOR = VIC_BASE + $21
BACKGROUND_COLOR1 = VIC_BASE + $22
BACKGROUND_COLOR2 = VIC_BASE + $23
BACKGROUND_COLOR3 = VIC_BASE + $24
SPRITE_MULTICOLOR0 = VIC_BASE + $25
SPRITE_MULTICOLOR1 = VIC_BASE + $26
SPRITE_COLOR0  = VIC_BASE + $27
SPRITE_COLOR1  = VIC_BASE + $28
SPRITE_COLOR2  = VIC_BASE + $29
SPRITE_COLOR3  = VIC_BASE + $2a
SPRITE_COLOR4  = VIC_BASE + $2b
SPRITE_COLOR5  = VIC_BASE + $2c
SPRITE_COLOR6  = VIC_BASE + $2d
SPRITE_COLOR7  = VIC_BASE + $2e

COLOR_BLACK      = 0
COLOR_WHITE      = 1
COLOR_RED        = 2
COLOR_CYAN       = 3
COLOR_PURPLE     = 4
COLOR_GREEN      = 5
COLOR_BLUE       = 6
COLOR_YELLOW     = 7
COLOR_ORANGE     = 8
COLOR_BROWN      = 9
COLOR_LIGHT_RED  = 10
COLOR_DARK_GRAY  = 11
COLOR_MID_GRAY   = 12
COLOR_LIGHT_GREEN = 13
COLOR_LIGHT_BLUE = 14
COLOR_LIGHT_GRAY = 15

;; ============================================================
;; Screen setup
;; ============================================================
!macro c64_clear_screen .addr, .value {
    ldx #$00
    lda #.value
.loop:
    sta .addr, x
    sta .addr + $100, x
    sta .addr + $200, x
    sta .addr + $300, x
    inx
    bne .loop
}

!macro c64_set_border .color {
    lda #.color
    sta BORDER_COLOR
}

!macro c64_set_background .color {
    lda #.color
    sta BACKGROUND_COLOR
}

!macro c64_set_multicolor .color1, .color2 {
    lda #.color1
    sta BACKGROUND_COLOR1
    lda #.color2
    sta BACKGROUND_COLOR2
}

!macro c64_wait_raster .line {
.wait:
    lda RASTER_LINE
    cmp #.line
    bne .wait
}

;; ============================================================
;; Sprite data placeholder (24x21 filled rectangle)
;; ============================================================
!macro c64_sprite_placeholder .index {
    !fill 63, $ff
    !byte $00
}
