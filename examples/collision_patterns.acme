;; Frame loop:
;;     wait_frame
;;     read_input
;;     dispatch_state     ; state decides which handler runs
;;     update_sprites
;;     goto frame_loop
;;
;; States as constants:
;;     GAME_SPLASH  = 0
;;     GAME_PLAYING = 1
;;     GAME_DYING   = 2
;;     GAME_OVER    = 3

