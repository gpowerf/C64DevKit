;; game_logic.acme — Sprite Dodge: full game logic
;; Keyboard input (WASD), enemy AI, collision, score, sound.

    jmp gcode

;; --- Variables ---
score:      !byte 0, 0     ; 16-bit score
enemy_x:    !byte 100
enemy_y:    !byte 80
enemy_init: !byte 0
hit_timer:  !byte 0        ; cooldown after hit
snd_timer:  !byte 0        ; sound duration counter

gcode:
    jsr keyboard_read
    jsr enemy_ai
    jsr check_collision
    jsr sound_tick
    rts


;; ============================================================
;; Keyboard input — WASD moves player
;; ============================================================
keyboard_read:
    lda #0
    sta joystick_state

    ;; W (up)
    lda #$fd
    sta $dc00
    lda $dc01
    and #$02
    bne k_chk_s
    lda joystick_state
    ora #JOY_UP
    sta joystick_state

k_chk_s:
    lda #$fd
    sta $dc00
    lda $dc01
    and #$20
    bne k_chk_a
    lda joystick_state
    ora #JOY_DOWN
    sta joystick_state

k_chk_a:
    lda #$fb
    sta $dc00
    lda $dc01
    and #$02
    bne k_chk_d
    lda joystick_state
    ora #JOY_LEFT
    sta joystick_state

k_chk_d:
    lda #$fb
    sta $dc00
    lda $dc01
    and #$08
    bne k_done
    lda joystick_state
    ora #JOY_RIGHT
    sta joystick_state

k_done:
    rts


;; ============================================================
;; Enemy AI — chases player
;; ============================================================
enemy_ai:
    lda enemy_init
    bne e_active
    inc enemy_init
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    rts

e_active:
    lda $d000
    cmp enemy_x
    beq e_chase_y
    bcc e_move_left
    inc enemy_x
    jmp e_chase_y
e_move_left:
    dec enemy_x

e_chase_y:
    lda $d001
    cmp enemy_y
    beq e_clamp
    bcc e_move_up
    inc enemy_y
    jmp e_clamp
e_move_up:
    dec enemy_y

e_clamp:
    lda enemy_x
    cmp #24
    bcs e_xmax
    lda #24
    sta enemy_x
    bne e_clamp_y
e_xmax:
    cmp #255
    bcc e_clamp_y
    lda #255
    sta enemy_x

e_clamp_y:
    lda enemy_y
    cmp #50
    bcs e_ymax
    lda #50
    sta enemy_y
    bne e_write
e_ymax:
    cmp #229
    bcc e_write
    lda #229
    sta enemy_y

e_write:
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    rts


;; ============================================================
;; Collision check — sprite 0 vs sprite 1
;; ============================================================
check_collision:
    lda hit_timer
    beq c_check
    dec hit_timer
    rts

c_check:
    lda $d01e
    and #$03
    beq c_no_hit

    sta $d01e

    clc
    lda score
    adc #10
    sta score
    lda score+1
    adc #0
    sta score+1

    lda #<4455
    sta $D400
    lda #>4455
    sta $D401
    lda #$11
    sta $D404
    lda #$4F
    sta $D405
    lda #$F0
    sta $D406
    lda #$0F
    sta $D418
    lda #15
    sta snd_timer

    lda $d012
    and #$3f
    clc
    adc #80
    sta enemy_x
    eor #$55
    and #$3f
    clc
    adc #60
    sta enemy_y

    lda #20
    sta hit_timer
    rts

c_no_hit:
    rts


;; ============================================================
;; Sound tick
;; ============================================================
sound_tick:
    lda snd_timer
    beq s_done
    dec snd_timer
    bne s_done
    lda $D404
    and #$FE
    sta $D404
s_done:
    rts
