;; ============================================================
;; Pattern 6: LFSR pseudo-random number generator
;; ============================================================
;;
;; 8-bit Galois LFSR with seed anti-stick guard.
;; Period: 255 (never produces 0, re-seeds if it would).

;; lfsr_seed:  !byte $5a       ; initial seed (non-zero)
;;
;; lfsr_tick:
;;     lda lfsr_seed
;;     lsr                     ; shift right, bit 0 goes to carry
;;     bcc .no_xor             ; if carry clear, skip XOR
;;     eor #$2d                ; XOR with polynomial
;; .no_xor:
;;     sta lfsr_seed
;;     bne .done               ; guard: never let seed = 0
;;     lda #$5a                ; re-seed
;;     sta lfsr_seed
;; .done:
;;     rts                     ; A = random byte 1-255
