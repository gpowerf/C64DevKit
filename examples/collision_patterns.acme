;; ============================================================
;; c64devk collision detection & game loop patterns
;; Reference: standard C64 hardware collision registers
;; License: MIT — freely usable
;; ============================================================
;;
;; C64 has two hardware collision registers:
;;   $D01E — sprite-sprite collision  (bits = pairs that overlap)
;;   $D01F — sprite-data collision    (bits = sprites overlapping data)
;;
;; Both are LATCHED registers: once a collision happens, the
;; corresponding bit stays set until you WRITE to the register.
;; Reading $D01E does NOT clear it — you must write back.
;;
;; To check multi-sprite collisions, read $D01E ONCE, save the
;; value, and clear by writing it back after all checks are done.

;; ============================================================
;; Pattern 1: Basic sprite-sprite collision check
;; ============================================================
;;
;;     ;; Check collision between sprite 0 and sprite 1
;;     lda $d01e               ; read collision register
;;     and #$03                ; bit 0 = 0-1, bit 1 = 0-2, etc.
;;     cmp #$01                ; check bit 0 (sprite 0 vs 1)
;;     bne .no_collision
;;     sta $d01e               ; acknowledge by writing back
;;     ;; handle collision
;; .no_collision:
;;     rts

;; ============================================================
;; Pattern 2: Multi-sprite collision (read once, check many)
;; ============================================================
;;
;;     lda $d01e               ; snapshot collision state
;;     sta collision_saved
;;
;;     ;; Check enemy (sprite 0 vs 1)
;;     lda collision_saved
;;     and #$01                ; bit 0: sprite 0-1
;;     beq .chk_rock
;;     jsr handle_enemy_hit    ; could clear $D01E with sta
;; .chk_rock:
;;     lda collision_saved
;;     and #$04                ; bit 2: sprite 0-2 (rock 0)
;;     beq .chk_rock2
;;     jsr handle_rock_hit
;; .chk_rock2:
;;     lda collision_saved
;;     and #$08                ; bit 3: sprite 0-3 (rock 1)
;;     beq .done
;;     jsr handle_rock_hit
;; .done:
;;     ;; Clear any remaining bits in $D01E
;;     lda collision_saved
;;     sta $d01e
;;     rts

;; ============================================================
;; Pattern 3: Distance-gated collision (hardware + software check)
;; ============================================================
;;
;; Hardware collision fires on ANY pixel overlap, even when
;; sprites barely touch at the edges.  Add a distance check
;; to only accept collisions when sprites are genuinely close.

;; === Absolute value of (A - B) ===
;;     ; Input:  A = pos1_x, B = pos2_x
;;     ; Output: A = |pos1_x - pos2_x|
;;     sec
;;     sbc pos2_x
;;     bcs .positive
;;     eor #$ff
;;     adc #1
;; .positive:
;;     cmp #18                 ; must be within 18 pixels
;;     bcs .too_far
;;     ;; genuine collision — sprites are close enough
;; .too_far:
;;     rts

;; ============================================================
;; Pattern 4: Game state machine (splash → playing → dying → over)
;; ============================================================
