;; game_logic.acme — Sprite Dodge: keyboard input + enemy AI
;; Runs every frame after behaviors_update.

    jmp .start

enemy_x:    !byte 100
enemy_y:    !byte 80
enemy_init: !byte 0

.start:
    ;; --- Keyboard input (WASD), runs BEFORE enemy AI ---
    jsr read_keyboard

    ;; --- First-frame init for enemy ---
    lda enemy_init
    bne .do_ai
    inc enemy_init
    lda #100
    sta enemy_x
    sta $d002
    lda #80
    sta enemy_y
    sta $d003
    rts

.do_ai:
    ;; Read player position from VIC-II registers (sprite 0)
    lda $d000
    sta $02
    lda $d001
    sta $03

    ;; --- Chase X ---
    lda $02
    cmp enemy_x
    beq .chase_y
    bcc .move_left
    inc enemy_x
    jmp .chase_y
.move_left:
    dec enemy_x

.chase_y:
    ;; --- Chase Y ---
    lda $03
    cmp enemy_y
    beq .clamp
    bcc .move_up
    inc enemy_y
    jmp .clamp
.move_up:
    dec enemy_y

.clamp:
    lda enemy_x
    cmp #24
    bcs .xmax
    lda #24
    sta enemy_x
    bne .clamp_y
.xmax:
    cmp #255
    bcc .clamp_y
    lda #255
    sta enemy_x

.clamp_y:
    lda enemy_y
    cmp #50
    bcs .ymax
    lda #50
    sta enemy_y
    bne .write
.ymax:
    cmp #229
    bcc .write
    lda #229
    sta enemy_y

.write:
    lda enemy_x
    sta $d002
    lda enemy_y
    sta $d003
    rts


;; ============================================================
;; Keyboard reader — WASD maps to UP/DOWN/LEFT/RIGHT, SPACE=fire
;; Directly writes to VIC-II sprite 0 position registers
;; ============================================================
read_keyboard:
    ;; Check W (up) — column 1 ($FE), row 1 ($01)
    lda #$fd
    sta $dc00
    lda $dc01
    and #$02
    bne .chk_s
    dec $d001              ; move player up
.chk_s:
    ;; Check S (down) — column 1, row 5 ($10)
    lda #$fd
    sta $dc00
    lda $dc01
    and #$20
    bne .chk_a
    inc $d001              ; move player down
.chk_a:
    ;; Check A (left) — column 2 ($FB), row 1 ($01)
    lda #$fb
    sta $dc00
    lda $dc01
    and #$02
    bne .chk_d
    dec $d000              ; move player left
.chk_d:
    ;; Check D (right) — column 2, row 3 ($04)
    lda #$fb
    sta $dc00
    lda $dc01
    and #$08
    bne .done
    inc $d000              ; move player right
.done:
    rts
